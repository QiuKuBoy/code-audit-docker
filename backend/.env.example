# ── LLM Providers (2026-08 latest models) ──────────────
# API keys are optional — you can enter them per-audit in the web UI.
# Copy this file to .env and fill in the keys you want to use.

# DeepSeek (V4-Flash free / V4-Pro flagship)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash

# OpenAI (GPT-5.5)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.5

# Anthropic (Claude Fable 5 / Opus 4.8)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-fable-5

# Google Gemini (3.5 Flash — I/O 2026)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Baidu Wenxin (ERNIE 4.5)
BAIDU_API_KEY=
BAIDU_MODEL=ernie-4.5-8k-latest

# ByteDance Doubao (Seed 2.0 Pro)
DOUBAO_API_KEY=
DOUBAO_MODEL=doubao-seed-2.0-pro-256k-250628

# MiniMax (M2.5)
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M2.5

# Zhipu GLM (GLM-5.2)
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-5.2

# Alibaba Tongyi Qianwen (Qwen3.8-Max)
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.8-max-preview

# Moonshot Kimi (K3 — 2.8T world's largest open-source)
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k3

# SiliconFlow (aggregator)
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=Qwen/Qwen3.8-Max-Preview

# ── App Settings ───────────────────────────────────────
DEFAULT_LLM_PROVIDER=deepseek
MAX_TURNS=50
MAX_TOOL_CALLS=200
CONTEXT_WINDOW_TOKENS=128000
COMPRESS_THRESHOLD=0.6
TOOL_RESULT_BUDGET=8000
DEBUG=false

# ── Security ────────────────────────────────────────────
# Master key for encrypting stored API keys at rest (Fernet).
# If unset, a machine-local .enc_key file is generated automatically.
API_KEY_ENCRYPTION_KEY=

# ── Scan Engines ────────────────────────────────────────
SEMGREP_ENABLED=true
SEMGREP_CONFIG=p/owasp-top-ten
SCA_ENABLED=true
SANDBOX_ENABLED=false

# ── MCP Servers (optional, configure via web UI instead) ───
# MCP servers are managed at runtime via the web UI or mcp_servers.json
# Do NOT put API keys/tokens here; use the Settings page.
