# ============================================================
# CodeAudit Docker 环境变量模板
# 复制为 .env 后填写:  cp .env.example .env
# 也可以不填，启动后在网页「设置」页添加 API Key
# ============================================================

# ── LLM API Keys（任一即可）──
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
BAIDU_API_KEY=
DOUBAO_API_KEY=
MINIMAX_API_KEY=
ZHIPU_API_KEY=
QWEN_API_KEY=
KIMI_API_KEY=
SILICONFLOW_API_KEY=

# 默认 LLM 提供商: deepseek / openai / anthropic / ...
DEFAULT_LLM_PROVIDER=deepseek

# 数据加密主密钥（建议设置 32 位以上随机字符串，保持稳定以免密钥失效）
# 生成: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY_ENCRYPTION_KEY=
